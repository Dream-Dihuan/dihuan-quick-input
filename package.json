{
  "name": "dihuan-quick-input",
  "version": "1.0.0",
  "description": "A desktop quick-input assistant with a browser bridge and local command plugins.",
  "main": "./out/main/index.js",
  "author": "Dihuan",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:extension": "tsc --noEmit -p tsconfig.extension.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:extension",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:extension": "node scripts/build-extension.mjs --watch",
    "build": "npm run typecheck && electron-vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "build:all": "npm run build && npm run build:extension && npm run zip:extension",
    "zip:extension": "node scripts/zip-extension.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:extension && playwright test",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build:all && electron-builder --dir",
    "build:win": "npm run build:all && electron-builder --win",
    "build:mac": "npm run build:all && electron-builder --mac",
    "build:linux": "npm run build:all && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "write-file-atomic": "^8.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^24.19.2",
    "@types/write-file-atomic": "^4.0.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
